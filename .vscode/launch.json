{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run PLM extension on sandbox/multicopter",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extension",
        "${workspaceFolder}/sandbox/multicopter"
      ],
      "outFiles": ["${workspaceFolder}/extension/dist/**/*.js"],
      "preLaunchTask": "build:ext"
    }
  ]
}
