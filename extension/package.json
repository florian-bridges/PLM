{
  "//": "VS-01.1, VS-01.2, VS-01.4, VS-01.5, VS-02.1, VS-03.1, VS-04.1, VS-04.2, VS-06.1",
  "name": "plm-vscode",
  "displayName": "PLM",
  "version": "0.1.0",
  "private": true,
  "publisher": "plm",
  "engines": { "vscode": "^1.105.0" },
  "main": "./dist/extension.js",
  "activationEvents": ["workspaceContains:plm.yaml"],
  "contributes": {
    "views": { "explorer": [{ "id": "plm.tree", "name": "PLM Product" }, { "id": "plm.links", "name": "PLM Links" }] },
    "commands": [
      { "command": "plm.editItem", "category": "PLM", "title": "Edit item", "icon": "$(edit)" },
      { "command": "plm.newItem", "category": "PLM", "title": "New item" },
      { "command": "plm.addLink", "title": "Add link", "icon": "$(add)" },
      { "command": "plm.recordTestRun", "title": "PLM: Record test run" },
      { "command": "plm.showRequirements", "title": "Show requirements", "icon": "$(book)" },
      { "command": "plm.showChange", "title": "Show change", "icon": "$(diff)" },
      { "command": "plm.confirm", "title": "Confirm", "icon": "$(check)" }
    ],
    "menus": {
      "view/title": [{ "command": "plm.addLink", "when": "view == plm.links", "group": "navigation" }],
      "explorer/context": [{ "command": "plm.newItem", "when": "explorerResourceIsFolder" }],
      "view/item/context": [
        { "command": "plm.newItem", "when": "view == plm.tree" },
        { "command": "plm.editItem", "when": "view == plm.tree", "group": "inline" },
        { "command": "plm.showRequirements", "when": "view == plm.tree", "group": "inline" },
        { "command": "plm.showChange", "when": "view == plm.links && viewItem == suspect", "group": "inline" },
        { "command": "plm.confirm", "when": "view == plm.links", "group": "inline" }
      ],
      "commandPalette": [
        { "command": "plm.addLink", "when": "false" },
        { "command": "plm.showRequirements", "when": "false" },
        { "command": "plm.showChange", "when": "false" },
        { "command": "plm.confirm", "when": "false" }
      ]
    }
  }
}
