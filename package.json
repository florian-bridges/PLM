{
  "name": "plm",
  "version": "0.3.0",
  "description": "Git-based product lifecycle management CLI: hierarchical items, requirements, tests and traceability links that turn suspect on change",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/florian-bridges/PLM.git"
  },
  "type": "module",
  "bin": {
    "plm": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "vitest run --exclude '.claude/**' --testTimeout=30000",
    "plm": "node src/cli.ts",
    "build:ext": "esbuild extension/src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=extension/dist/extension.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p extension"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "commander": "^15.0.0",
    "minisearch": "^7.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/vscode": "1.105",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
